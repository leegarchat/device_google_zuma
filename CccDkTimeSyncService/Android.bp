android_app_import {
    name: "CccDkTimeSyncService",
    owner: "google",
    apk: "common/proprietary/system_ext/priv-app/CccDkTimeSyncService/CccDkTimeSyncService.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
    privileged: true,
}

prebuilt_etc {
    name: "org.carconnectivity.android.digitalkey.timesync.xml",
    sub_dir: "permissions",
    src: "common/proprietary/system_ext/etc/permissions/org.carconnectivity.android.digitalkey.timesync.xml",
    filename_from_src: true,
    system_ext_specific: true,
}

dex_import {
    name: "org.carconnectivity.android.digitalkey.timesync",
    owner: "google",
    jars: [
        "common/proprietary/system_ext/framework/org.carconnectivity.android.digitalkey.timesync.jar",
    ],
    system_ext_specific: true,
}
